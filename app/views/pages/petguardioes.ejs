<!DOCTYPE html>
<html lang="pt-BR">
 
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
 
    <title>PetGuardião Premium</title>
 
    <!-- Fonte Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >
 
    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
 
    <!-- CSS principal -->
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/header-geral.css">
</head>
 
<body class="guardioes">

   <!-- =====================================================
         HEADER ORIGINAL
    ====================================================== -->

<% if (!usuario) { %>

    <%- include("../partials/header-principal-1") %>

<% } else if (usuario.premium) { %>

    <%- include("../partials/header-principal-3") %>

<% } else { %>

    <%- include("../partials/header-principal-2") %>

<% } %>


<!-- =========================================
     MENU MOBILE
========================================= -->
 <a href="/" class="logo">
            <i class="fa-solid fa-paw logo-icon"></i>
            <span class="logo-text">PetSpace</span>
        </a>
<nav class="navbar" aria-label="Menu mobile">
 
    <section
        id="mobile-menu"
        class="mobile-menu"
        aria-hidden="true">

        <!-- BOTÕES -->
        <section class="mobile-buttons">

            <a href="/">
                <i class="fa-solid fa-house"></i>
                Início
            </a>

            <a href="/login">
                <i class="fa-solid fa-user"></i>
                Entrar
            </a>

            <a href="/cadastro">
                <i class="fa-solid fa-user-plus"></i>
                Cadastre-se
            </a>

            <a href="/petguardioes" class="btn-pro">
                <i class="fa-solid fa-crown"></i>
                PetGuardião PRO
            </a>

        </section>

        <hr>

        <!-- LINKS -->
        <ul>

            <li>
                <a href="#guardioes-beneficios">
                    <i class="fa-solid fa-bag-shopping"></i>
                    Produtos
                </a>
            </li>

            <li>
                <a href="/compras">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Compras
                </a>
            </li>

            <li>
                <a href="/contato">
                    <i class="fa-solid fa-phone"></i>
                    Contato
                </a>
            </li>

        </ul>

    </section>


    <!-- BOTÃO INFERIOR -->

    <button
        id="menu-btn"
        class="menu-btn"
        type="button"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu">

        <i class="fa-solid fa-bars"></i>

    </button>

</nav>
    
 
    <main>
 
        <!-- HERO -->
        <section
            class="guardioes-hero"
            id="guardioes-inicio"
        >
 
            <h1>
                Proteção Premium para
                <span>
                    o seu melhor amigo
                </span>
            </h1>
 
            <p>
                Monitoramento, vacinas, histórico médico,
                alertas inteligentes e suporte especializado
                para cuidar do seu pet.
            </p>
 
            <a
                href="#guardioes-planos"
                class="guardioes-btn guardioes-botaopremium"
            >
                Experimente por R$ 1,90
            </a>
 
        </section>
 
 
        <!-- BENEFÍCIOS -->
        <section
            class="guardioes-beneficios"
            id="guardioes-beneficios"
        >
 
            <h2>
                Experimente a diferença
            </h2>
 
            <div class="guardioes-tabela-container">
 
                <table class="guardioes-tabela">
 
                    <thead>
                        <tr>
                            <th>Benefícios</th>
                            <th>Grátis</th>
                            <th>Premium</th>
                        </tr>
                    </thead>
 
                    <tbody>
 
                        <tr>
                            <td>Histórico de Vacinas</td>
                            <td class="guardioes-check">✓</td>
                            <td class="guardioes-check">✓</td>
                        </tr>
 
                        <tr>
                            <td>Alertas Automáticos</td>
                            <td class="guardioes-x">✕</td>
                            <td class="guardioes-check">✓</td>
                        </tr>
 
                        <tr>
                            <td>Consultas Online</td>
                            <td class="guardioes-x">✕</td>
                            <td class="guardioes-check">✓</td>
                        </tr>
 
                        <tr>
                            <td>Suporte Prioritário</td>
                            <td class="guardioes-x">✕</td>
                            <td class="guardioes-check">✓</td>
                        </tr>
 
                        <tr>
                            <td>Backup na Nuvem</td>
                            <td class="guardioes-x">✕</td>
                            <td class="guardioes-check">✓</td>
                        </tr>
 
                    </tbody>
 
                </table>
 
            </div>
 
        </section>
 
 
        <!-- PLANOS -->
        <section
            class="guardioes-planos"
            id="guardioes-planos"
        >
 
            <!-- INDIVIDUAL -->
            <article class="guardioes-card">
 
                <span class="guardioes-tag">
                    POPULAR
                </span>
 
                <h3>
                    Individual
                </h3>
 
                <p class="guardioes-preco">
                    R$ 19,90/mês
                </p>
 
                <ul>
                    <li>1 Pet</li>
                    <li>Vacinas</li>
                    <li>Alertas</li>
                    <li>Suporte</li>
                </ul>
 
                <button
                    type="button"
                    class="guardioes-assinar"
                    data-plano="Individual"
                >
                    Assinar
                </button>
 
            </article>
 
 
            <!-- DUO -->
            <article class="guardioes-card">
 
                <span class="guardioes-tag">
                    ECONOMIA
                </span>
 
                <h3>
                    Duo
                </h3>
 
                <p class="guardioes-preco">
                    R$ 29,90/mês
                </p>
 
                <ul>
                    <li>2 Pets</li>
                    <li>Histórico Completo</li>
                    <li>Alertas</li>
                    <li>Suporte</li>
                </ul>
 
                <button
                    type="button"
                    class="guardioes-assinar"
                    data-plano="Duo"
                >
                    Assinar
                </button>
 
            </article>
 
 
            <!-- FAMÍLIA -->
            <article class="guardioes-card guardioes-destaque">
 
                <span class="guardioes-tag">
                    MAIS VENDIDO
                </span>
 
                <h3>
                    Família
                </h3>
 
                <p class="guardioes-preco">
                    R$ 49,90/mês
                </p>
 
                <ul>
                    <li>Até 5 Pets</li>
                    <li>Consultas</li>
                    <li>Relatórios</li>
                    <li>Suporte VIP</li>
                </ul>
 
                <button
                    type="button"
                    class="guardioes-assinar"
                    data-plano="Família"
                >
                    Assinar
                </button>
 
            </article>
 
 
            <!-- PRO -->
            <article class="guardioes-card">
 
                <span class="guardioes-tag">
                    PRO
                </span>
 
                <h3>
                    PetGuardião PRO
                </h3>
 
                <p class="guardioes-preco">
                    R$ 79,90/mês
                </p>
 
                <ul>
                    <li>Pets ilimitados</li>
                    <li>IA Veterinária</li>
                    <li>Backup Premium</li>
                    <li>Suporte 24h</li>
                </ul>
 
                <button
                    type="button"
                    class="guardioes-assinar"
                    data-plano="PRO"
                >
                    Assinar
                </button>
 
            </article>
 
        </section>
 
    </main>
 
 
    <!-- FOOTER -->
    <footer class="guardioes-footer">
 
        <p>
            ©️ 2025 PetGuardião Premium
        </p>
 
    </footer>
 
 
    <!-- MODAL DE LOGIN -->
    <dialog
        id="guardioes-loginModal"
        class="guardioes-dialog"
    >
 
        <form
            method="dialog"
            class="guardioes-login-form"
        >
 
            <h2>
                Entrar
            </h2>
 
            <input
                type="email"
                placeholder="Seu e-mail"
                required
                autocomplete="email"
            >
 
            <input
                type="password"
                placeholder="Senha"
                required
                autocomplete="current-password"
            >
 
            <menu class="guardioes-dialog-menu">
 
                <button
                    type="button"
                    value="cancel"
                    id="guardioes-fechar-login"
                    class="guardioes-modal-cancelar"
                >
                    Cancelar
                </button>
 
                <button
                    type="submit"
                    id="guardioes-loginBtn"
                    class="guardioes-modal-entrar"
                >
                    Entrar
                </button>
 
            </menu>
 
        </form>
 
    </dialog>
 
 
    <!-- TOAST -->
    <div
        id="guardioes-toast"
        role="status"
        aria-live="polite"
    ></div>
 
 
    <!-- JAVASCRIPT -->
    <script>
 
       document.addEventListener("DOMContentLoaded", function () {

    /* =====================================================
       TOAST
    ===================================================== */

    const toast = document.getElementById("guardioes-toast");

    function mostrarToast(mensagem) {

        if (!toast) {
            return;
        }

        toast.textContent = mensagem;

        toast.classList.add("guardioes-show");

        setTimeout(function () {
            toast.classList.remove("guardioes-show");
        }, 3000);
    }


    /* =====================================================
       BOTÕES DOS PLANOS
    ===================================================== */

    const botoesAssinar =
        document.querySelectorAll(".guardioes-assinar");

    botoesAssinar.forEach(function (botao) {

        botao.addEventListener("click", function () {

            const plano =
                botao.getAttribute("data-plano");

            mostrarToast(
                "Você selecionou o plano " + plano + "!"
            );

        });

    });


    /* =====================================================
       BOTÃO "EXPERIMENTE POR R$ 1,90"
    ===================================================== */

    const botaoPremium =
        document.querySelector(".guardioes-botaopremium");

    if (botaoPremium) {

        botaoPremium.addEventListener(
            "click",
            function (evento) {

                evento.preventDefault();

                const planos =
                    document.getElementById(
                        "guardioes-planos"
                    );

                if (planos) {

                    planos.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });

                }

            }
        );

    }


    /* =====================================================
       MODAL DE LOGIN
    ===================================================== */

    const loginModal =
        document.getElementById(
            "guardioes-loginModal"
        );

    const abrirLogin =
        document.getElementById(
            "guardioes-abrir-login"
        );

    const fecharLogin =
        document.getElementById(
            "guardioes-fechar-login"
        );

    const loginBtn =
        document.getElementById(
            "guardioes-loginBtn"
        );


    /* =====================================================
       ABRIR LOGIN
    ===================================================== */

    if (abrirLogin && loginModal) {

        abrirLogin.addEventListener(
            "click",
            function (evento) {

                evento.preventDefault();

                if (typeof loginModal.showModal === "function") {

                    loginModal.showModal();

                } else {

                    loginModal.setAttribute(
                        "open",
                        ""
                    );

                }

            }
        );

    }


    /* =====================================================
       FECHAR LOGIN
    ===================================================== */

    if (fecharLogin && loginModal) {

        fecharLogin.addEventListener(
            "click",
            function () {

                if (typeof loginModal.close === "function") {

                    loginModal.close();

                } else {

                    loginModal.removeAttribute(
                        "open"
                    );

                }

            }
        );

    }


    /* =====================================================
       LOGIN
    ===================================================== */

    if (loginBtn && loginModal) {

        loginBtn.addEventListener(
            "click",
            function (evento) {

                const email =
                    loginModal.querySelector(
                        'input[type="email"]'
                    );

                const senha =
                    loginModal.querySelector(
                        'input[type="password"]'
                    );


                if (!email || !senha) {
                    return;
                }


                const emailValor =
                    email.value.trim();

                const senhaValor =
                    senha.value.trim();


                if (
                    emailValor === "" ||
                    senhaValor === ""
                ) {

                    mostrarToast(
                        "Preencha seu e-mail e sua senha."
                    );

                    return;

                }


                evento.preventDefault();


                if (
                    typeof loginModal.close ===
                    "function"
                ) {

                    loginModal.close();

                } else {

                    loginModal.removeAttribute(
                        "open"
                    );

                }


                mostrarToast(
                    "Login realizado com sucesso!"
                );

            }
        );

    }


    /* =====================================================
       FECHAR MODAL CLICANDO FORA
    ===================================================== */

    if (loginModal) {

        loginModal.addEventListener(
            "click",
            function (evento) {

                const areaModal =
                    loginModal.getBoundingClientRect();


                const clicouFora =
                    evento.clientX < areaModal.left ||
                    evento.clientX > areaModal.right ||
                    evento.clientY < areaModal.top ||
                    evento.clientY > areaModal.bottom;


                if (clicouFora) {

                    if (
                        typeof loginModal.close ===
                        "function"
                    ) {

                        loginModal.close();

                    } else {

                        loginModal.removeAttribute(
                            "open"
                        );

                    }

                }

            }
        );

    }


    /* =====================================================
       MENU MOBILE
    ===================================================== */

    const menuBtn =
        document.getElementById(
            "menu-btn"
        );

    const mobileMenu =
        document.getElementById(
            "mobile-menu"
        );


    if (menuBtn && mobileMenu) {

        const menuIcon =
            menuBtn.querySelector("i");


        /* ---------------------------------------------
           FUNÇÃO PARA ABRIR/FECHAR
        --------------------------------------------- */

        function alternarMenu() {

            const menuAberto =
                mobileMenu.classList.toggle(
                    "active"
                );


            menuBtn.setAttribute(
                "aria-expanded",
                menuAberto ? "true" : "false"
            );


            mobileMenu.setAttribute(
                "aria-hidden",
                menuAberto ? "false" : "true"
            );


            /* TROCA O ÍCONE */

            if (menuIcon) {

                if (menuAberto) {

                    menuIcon.classList.remove(
                        "fa-bars"
                    );

                    menuIcon.classList.add(
                        "fa-xmark"
                    );

                    menuBtn.setAttribute(
                        "aria-label",
                        "Fechar menu"
                    );

                } else {

                    menuIcon.classList.remove(
                        "fa-xmark"
                    );

                    menuIcon.classList.add(
                        "fa-bars"
                    );

                    menuBtn.setAttribute(
                        "aria-label",
                        "Abrir menu"
                    );

                }

            }

        }


        /* ---------------------------------------------
           CLIQUE NO BOTÃO ☰
        --------------------------------------------- */

        menuBtn.addEventListener(
            "click",
            function (evento) {

                evento.stopPropagation();

                alternarMenu();

            }
        );


        /* ---------------------------------------------
           LINKS DO MENU
        --------------------------------------------- */

        const linksMenu =
            mobileMenu.querySelectorAll("a");


        linksMenu.forEach(function (link) {

            link.addEventListener(
                "click",
                function () {

                    mobileMenu.classList.remove(
                        "active"
                    );


                    menuBtn.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    mobileMenu.setAttribute(
                        "aria-hidden",
                        "true"
                    );


                    if (menuIcon) {

                        menuIcon.classList.remove(
                            "fa-xmark"
                        );

                        menuIcon.classList.add(
                            "fa-bars"
                        );

                    }


                    menuBtn.setAttribute(
                        "aria-label",
                        "Abrir menu"
                    );

                }
            );

        });


        /* ---------------------------------------------
           CLICAR FORA DO MENU
        --------------------------------------------- */

        document.addEventListener(
            "click",
            function (evento) {

                const clicouNoMenu =
                    mobileMenu.contains(
                        evento.target
                    );

                const clicouNoBotao =
                    menuBtn.contains(
                        evento.target
                    );


                if (
                    !clicouNoMenu &&
                    !clicouNoBotao
                ) {

                    mobileMenu.classList.remove(
                        "active"
                    );


                    menuBtn.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    mobileMenu.setAttribute(
                        "aria-hidden",
                        "true"
                    );


                    if (menuIcon) {

                        menuIcon.classList.remove(
                            "fa-xmark"
                        );

                        menuIcon.classList.add(
                            "fa-bars"
                        );

                    }


                    menuBtn.setAttribute(
                        "aria-label",
                        "Abrir menu"
                    );

                }

            }
        );


        /* ---------------------------------------------
           ESC DO TECLADO
        --------------------------------------------- */

        document.addEventListener(
            "keydown",
            function (evento) {

                if (evento.key === "Escape") {

                    mobileMenu.classList.remove(
                        "active"
                    );


                    menuBtn.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    mobileMenu.setAttribute(
                        "aria-hidden",
                        "true"
                    );


                    if (menuIcon) {

                        menuIcon.classList.remove(
                            "fa-xmark"
                        );

                        menuIcon.classList.add(
                            "fa-bars"
                        );

                    }


                    menuBtn.setAttribute(
                        "aria-label",
                        "Abrir menu"
                    );

                }

            }
        );

    }


    /* =====================================================
       FECHAR MENU QUANDO A TELA VOLTAR PARA DESKTOP
    ===================================================== */

    window.addEventListener(
        "resize",
        function () {

            if (window.innerWidth > 768) {

                if (mobileMenu) {

                    mobileMenu.classList.remove(
                        "active"
                    );

                    mobileMenu.setAttribute(
                        "aria-hidden",
                        "true"
                    );

                }


                if (menuBtn) {

                    menuBtn.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                }


                const menuIcon =
                    menuBtn
                        ? menuBtn.querySelector("i")
                        : null;


                if (menuIcon) {

                    menuIcon.classList.remove(
                        "fa-xmark"
                    );

                    menuIcon.classList.add(
                        "fa-bars"
                    );

                }

            }

        }
    );

});
    </script>
 
</body>
 
</html>