<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetSpace</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- HEADER -->

    <header>
        <section class="container header-container">

            <a class="logo">
                <i class="fa-solid fa-paw logo-icon"></i>
                <section class="logo-text">PetSpace</section>
            </a>

            <nav>

          <button
    id="menu-btn"
    class="menu-btn"
    aria-label="Abrir menu"
    alt="Abrir menu">
    <i class="fa-solid fa-bars" aria-hidden="true"></i>
</button>
                <ul>
                    <li><a href="/">Início</a></li>
                    <li><a href="/compras">Compras</a></li>
                    <li><a href="/contato">Contato</a></li>
                </ul>


            </nav>


            <section class="nav-buttons">
                <a href="login" class="btn btn-secondary">Entrar</a>
                <a href="cadastro" class="btn btn-primary">Cadastre-se</a>
                <a href="petguardioes" class="btn-pro">
                    <i class="fa-solid fa-crown"></i>
                    PetGuardião PRO
                </a>

            </section>

        </section>
    </header>
    <!-- HERO -->
    <nav class="navbar">

        <button id="menu-btn" class="menu-btn">
            <i class="fa-solid fa-bars"></i>
        </button>

        <section id="mobile-menu" class="mobile-menu">

            <section class="mobile-buttons">
                <a href="login" class="btn btn-secondary">
                    <i class="fa-solid fa-user"></i>
                    Entrar
                </a>

                <a href="cadastro" class="btn btn-primary">
                    <i class="fa-solid fa-user-plus"></i>
                    Cadastre-se
                </a>

                <a href="/app/views/pages/petguardioes.ejs" class="btn-pro">
                    <i class="fa-solid fa-crown"></i>
                    PetGuardião PRO
                </a>
            </section>

            <hr>

            <ul>
              
                <li>
                    <a href="#product">
                        <i class="fa-solid fa-bag-shopping"></i>
                        Produtos
                    </a>
                </li>

                <li>
                    <a href="/compras">
                        <i class="fa-solid fa-cart-shopping"></i>
                        Compras
                    </a>
                </li>

                <li>
                    <a href="/app/views/pages/contato.ejs">
                        <i class="fa-solid fa-phone"></i>
                        Contato
                    </a>
                </li>
            </ul>

        </section>

    </nav>
<section class="hero">

    <!-- VÍDEO DE FUNDO -->
    <video class="hero-video" id="heroVideo" autoplay muted playsinline>
        <source src="imagem/video.mp4" type="video/mp4">
    </video>

    <!-- ESCURECIMENTO DO VÍDEO -->
    <div class="hero-overlay"></div>
    <div class="hero-gradient"></div>


    <section class="container">

        <article class="hero-content">

            <section class="hero-subtitle">
                <i class="fa-solid fa-paw"></i>
                Cuidado e amor para seu pet
            </section>

            <h1 class="hero-title">
                Tudo para o bem-estar<br>
                <span>do seu melhor amigo</span>
            </h1>

            <p class="hero-text">
                Um lugar especial para cuidar do seu pet.
                Na PetSpace, oferecemos produtos e serviços
                de qualidade com muito amor, carinho e dedicação.
            </p>

            <section class="hero-buttons">

                <a href="/compras" class="btn btn-primary">
                    Ver Produtos
                </a>

                <a href="cadastro.html" class="btn btn-secondary">
                    Conheça nossos Serviços
                </a>

            </section>

        </article>

    </section>

</section>
    <section class="products" id="product">

        <section class="container-product">

            <section class="section-header">
                <p class="section-subtitle">Nossos Produtos</p>
                <h2 class="section-title">Tudo para o seu Pet</h2>
                <p class="section-desc">
                    Produtos selecionados com qualidade para garantir saúde,
                    conforto e sectionersão ao seu melhor amigo.
                </p>
            </section>

            <section class="product-grid">

                <!-- Produto 1 -->
                <section class="product-card">
                    <img src="imagem/1.webp" alt="Ração Premium">

                    <section class="product-info">
                        <h3>Ração Premium 15 kg</h3>
                        <p>
                            Nutrição completa para cães de todas as idades.
                        </p>

                        <footer class="product-footer">
                            <span class="product-price">R$ 59,90</span>
                            <a href="/compras" class="btn btn-primary">
                                Comprar
                            </a>
                        </footer>
                    </section>
                </section>

                <!-- Produto 2 -->
                <section class="product-card">
                    <img src="imagem/brinquedo-interativo.webp" alt="Brinquedo Interativo">

                    <section class="product-info">
                        <h3>Brinquedo Interativo</h3>
                        <p>
                            Estimula a inteligência e reduz o estresse.
                        </p>

                        <section class="product-footer">
                            <span class="product-price">R$ 5,90</span>
                            <a href="/compras" class="btn btn-primary">
                                Comprar
                            </a>
                        </section>
                    </section>
                </section>

                <!-- Produto 3 -->
                <section class="product-card">
                    <img src="imagem/4.webp" alt="Caminha Confortável">

                    <section class="product-info">
                        <h3>Caminha Luxo</h3>
                        <p>
                            Conforto máximo para o descanso do seu pet.
                        </p>

                        <section class="product-footer">
                            <span class="product-price">R$ 100,90</span>
                            <a href="/compras" class="btn btn-primary">
                                Comprar
                            </a>
                        </section>
                    </section>
                </section>
    

            </section>

        </section>

        <section class="petguardioes-pro">
            <h2>PetGuardiões PRO</h2>
            <p class="descricao-pro">
                O PetGuardiões PRO foi criado para quem deseja oferecer o melhor
                cuidado para seu pet. Com benefícios exclusivos, descontos especiais
                ê garante mais segurança, economia e
                bem-estar para seu melhor amigo, tudo por apena <span>R$59,90 Mensal</span>
            </p>
            <section class="beneficios-pro">
                <section class="card-pro">
                    <i class="fa-solid fa-shield-dog"></i>
                    <h3>Proteção Completa</h3>
                    <p>Mais segurança e suporte para você e seu pet,com um plano de saude para seu pet.</p>
                </section>
                <section class="card-pro">
                    <i class="fa-solid fa-stethoscope"></i>
                    <h3>Saúde Animal</h3>
                    <p>Dicas, orientações e acesso a parceiros especializados.</p>
                </section>
                <section class="card-pro">
                    <i class="fa-solid fa-tags"></i>
                    <h3>Descontos Exclusivos</h3>
                    <p>Economize em produtos, serviços e acessórios.</p>
                </section>
                <section class="card-pro">
                    <i class="fa-solid fa-crown"></i>
                    <h3>Benefícios Premium</h3>
                    <p>Promoções especiais e vantagens exclusivas para assinantes.</p>
                </section>
            </section>
            <section class="nav-buttons">

                <a href="premium.html" class="btn-center">
                    <i class="fa-solid fa-crown"></i>
                    PetGuardião PRO
                </a>

            </section>
        </section>



        <section class="ods">
            <h2>Compromisso com os ODS</h2>
            <section class="ods-container">
                <section class="ods-card">
                    <h3>ODS 3</h3>
                    <p>

                        Promovemos saúde e bem-estar animal através de produtos

                        que garantem conforto e qualidade de vida aos pets.
                    </p>
                </section>
                <section class="ods-card">
                    <h3>ODS 14</h3>
                    <p>

                        Apoiamos promovendo o cuidado com o meio ambiente, incentivando o consumo consciente e práticas
                        que ajudam a reduzir a poluição e proteger a vida nos oceanos.
                    </p>
                    </p>
                </section>
                <section class="ods-card">
                    <h3>ODS 15</h3>
                    <p>
                        Valorizamos a proteção da vida terrestre e o respeito aos

                        animais e ao meio ambiente.
                </section>
                <section class="ods-card">
                    <h3>ODS 17</h3>
                    <p>

                        Fortalecemos parcerias e colaborações para alcançar um desenvolvimento sustentável mais
                        eficiente.

                    </p>
                </section>
            </section>
        </section>



        <footer>
            <section class="tudo-footer">
                <section class="footer-content">
                    <section class="footer-column">
                        <h3>Sobre </h3>
                        <p style="color:var( --paw-cream);margin-bottom: 20px;">PetSpace dedicado a um mundo mais
                            sustentavel, e facil para voce e seus amiguinhos PetSpace
                            um perfeito desenvolvimento ambiental.
                        </p>
                        <section class="social-links">
                            <a href="#"><i class="fa-brands fa-facebook-f" style="color: rgb(0, 0, 0);"></i></a>
                            <a href="#"><i class="fa-brands fa-instagram" style="color: rgb(0, 0, 0);"></i></a>
                            <a href="#"><i class="fa-brands fa-twitter" style="color: rgb(0, 0, 0);"></i></a>
                            <a href=""><i class="fa-brands fa-pinterest" style="color: rgb(0, 0, 0);"></i></a>

                        </section>
                    </section>

                    <section class="footer-column">
                        <h3>Clique Links</h3>
                        <ul class="footer-links">
                            <li><a href="#">Faça parte do nosso blog</a></li>
                            <li><a href="#">Adione seu perfil de vendas</a></li>
                            <li><a href="#">Curiosidades


                        </ul>
                    </section>
                    <section class="footer-column">
                        <h3>Entre em Contato conosco</h3>
                        <ul class="footer-links">
                            <li><i class="fa-solid fa-phone" style="color: rgb(255, 193, 59);"></i>+55 (99) 99999-9999
                            </li>
                            <li><i class="fa-solid fa-envelope" style="color: rgb(255, 193, 59);"></i>PetSpace@gmail.com
                            </li>
                            <li><i class="fa-solid fa-clock" style="color: rgb(255, 193, 59);"></i>9:00 as 18:00</li>
                            <li><i class="fa-regular fa-map" style="color: rgb(255, 193, 59);"></i>9:00 as 18:00</li>




                        </ul>

                    </section>
                </section>
            </section>


        </footer>

        <script src="scripts/script-index.js"></script>


        <script>
            const menuBtn = document.getElementById("menu-btn");
            const mobileMenu = document.getElementById("mobile-menu");

            menuBtn.addEventListener("click", () => {

                mobileMenu.classList.toggle("active");

            });
        </script>

        
</body>

</html>