<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suporte</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="body-contato">

  <!-- =====================================================
         HEADER ORIGINAL
    ====================================================== -->

<% if (!usuario) { %>

    <%- include("../partials/header-principal-1") %>

<% } else if (usuario.premium) { %>

    <%- include("../partials/header-premium") %>

<% } else { %>

    <%- include("../partials/header-principal-2") %>

<% } %>
 
  

    <main class="main-contato">
       
    
     <section class="mascara-form" onclick="esconderForm()"></section>


        <section class="caixa-ajuda">
            <h2 class="h2-contato">Conheça as perguntas frequentes</h2>
            <p class="p-contato">Cadastro de Pets <span class="span-contato">›</span></p>
            <p class="p-contato">Adoção <span class="span-contato">›</span></p>
            <p class="p-contato">Segurança e acesso à conta <span class="span-contato">›</span></p>
            <p class="p-contato">Contato com suporte <span class="span-contato">›</span></p>
            <button onclick="cliqueiNoBotao()" class="botao-contato">Entre em Contato Já</button>    
 
        </section>
         <form class="formulario-contato"  
  action="https://formcarry.com/s/kiqJ38TxPC1"
  method="POST"
  enctype="multipart/form-data">
        <h2 class="h2-form">Suporte</h2>
        <input type="text" placeholder="Seu nome" name="nome" class="input-contato">
        <input type="text" placeholder="Seu email" name="email" class="input-contato">
        <textarea type="text" placeholder= "Digite seu problema aqui"name="problema"  ></textarea>
        
        <button class="botao-contato">Enviar Duvida</button>    
 
    </form>

        <section class="caixa-link-whatsapp">
            <a href="https://w.app/ho5t9o" class="link-whatsapp">
                <img src="./imagem/zap.png" alt="Imagem do link inferior direto do whatszap ">
            </a>
        </section>

    </main>


    <script>
        const menuBtn = document.getElementById("menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");

        menuBtn.addEventListener("click", () => {

            mobileMenu.classList.toggle("active");

        });
    </script>

        <script src="scripts/scripts-contato.js"></script>



</body>

</html>