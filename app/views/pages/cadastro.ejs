
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <link rel="stylesheet" href="/css/login.css">

    <title>Cadastro | PetSpace</title>
</head>

<body>

<%
    const campos = ["nome", "sobrenome", "email", "senha"];

    const erroValidacao = {
        nome: "",
        sobrenome: "",
        email: "",
        senha: ""
    };

    const msgErro = {
        nome: "",
        sobrenome: "",
        email: "",
        senha: ""
    };

    const listaErros = Array.isArray(erros)
        ? erros
        : (erros && Array.isArray(erros.errors) ? erros.errors : []);

    listaErros.forEach(function(erro) {
        if (erro.path && campos.includes(erro.path)) {
            erroValidacao[erro.path] = "erro";

            if (!msgErro[erro.path]) {
                msgErro[erro.path] = erro.msg;
            }
        }
    });
%>

<section class="container">
    <section class="form">

        <form action="/cadastro" method="POST"
              id="formCadastro" class="formulario">

            <section class="form-header">
                <section class="title">
                    <h1>Cadastre-se</h1>
                </section>
            </section>

            <section class="input-group">

                <section class="input-box">
                    <label for="nome">Nome</label>

                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        placeholder="Digite seu nome"
                        minlength="3"
                        maxlength="15"
                        pattern="[A-Za-zÀ-ÿ ]+"
                        value="<%= valores ? valores.nome : '' %>"
                        class="<%= erroValidacao.nome %>"
                        aria-invalid="<%= erroValidacao.nome ? 'true' : 'false' %>"
                        aria-describedby="erro-nome"
                        required>

                    <small id="erro-nome" class="erro-texto"><%= msgErro.nome %></small>
                </section>

                <section class="input-box">
                    <label for="sobrenome">Sobrenome</label>

                    <input
                        type="text"
                        id="sobrenome"
                        name="sobrenome"
                        placeholder="Digite seu sobrenome"
                        minlength="3"
                        maxlength="100"
                        value="<%= valores ? valores.sobrenome : '' %>"
                        class="<%= erroValidacao.sobrenome %>"
                        aria-invalid="<%= erroValidacao.sobrenome ? 'true' : 'false' %>"
                        aria-describedby="erro-sobrenome"
                        required>

                    <small id="erro-sobrenome" class="erro-texto"><%= msgErro.sobrenome %></small>
                </section>

                <section class="input-box">
                    <label for="email">E-mail</label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Digite seu e-mail"
                        value="<%= valores ? valores.email : '' %>"
                        class="<%= erroValidacao.email %>"
                        aria-invalid="<%= erroValidacao.email ? 'true' : 'false' %>"
                        aria-describedby="erro-email"
                        required>

                    <small id="erro-email" class="erro-texto"><%= msgErro.email %></small>
                </section>

                <section class="input-box">
                    <label for="senha">Senha</label>

                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        placeholder="Digite sua senha"
                        minlength="8"
                        maxlength="72"
                        class="<%= erroValidacao.senha %>"
                        aria-invalid="<%= erroValidacao.senha ? 'true' : 'false' %>"
                        aria-describedby="erro-senha"
                        required>

                    <small id="erro-senha" class="erro-texto"><%= msgErro.senha %></small>
                </section>

            </section>

            <button type="submit" class="login">Cadastrar</button>

            <section class="register-link">
                Já possui uma conta?
                <a href="/login">Entrar</a>
            </section>

        </form>
    </section>
</section>

</body>
</html>
