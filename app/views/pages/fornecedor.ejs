    <script>

        /*
        ======================================================
        ID DO FORNECEDOR
        ======================================================

        Exemplos:

        /fornecedor/1
        /fornecedor/25
        /fornecedor/348

        O ID será utilizado futuramente para buscar
        os dados no banco de dados.
        */

        const fornecedorId =
            window.location.pathname.split("/")[2];


        console.log(
            "Fornecedor carregado:",
            fornecedorId
        );


        /*
        ======================================================
        DADOS TEMPORÁRIOS
        ======================================================

        Atualmente os dados são fictícios.

        Futuramente este objeto será substituído
        pelo retorno da API/banco de dados.
        */

        const fornecedor = {

            id: fornecedorId || 1,

            nome: "Pet & Cia",

            categoria:
                "Pet Shop e Produtos para Animais",

            status: "aberta",

            logo:
                "imagem/logo-fornecedor.webp",

            capa:
                "imagem/capa-fornecedor.webp",

            descricao:
                "A Pet & Cia é uma loja especializada em produtos para animais de estimação, oferecendo produtos selecionados para proporcionar mais conforto, diversão e bem-estar aos pets.",

            telefone:
                "(11) 99999-9999",

            email:
                "contato@petecia.com.br",

            endereco:
                "São Paulo - SP",

            whatsapp:
                "5511999999999",

            avaliacao: 4.9,

            totalAvaliacoes: 128,

            totalProdutos: 84,

            desde:
                "2024",

            horario:
                "Segunda a sexta: 09h às 18h. | Sábado: 09h às 14h. | Domingo: fechado.",

            entrega:
                "A loja realiza entregas para regiões selecionadas.",

            pagamento:
                "Pix, cartão de crédito, cartão de débito e outras formas disponibilizadas pela loja."

        };


        /*
        ======================================================
        PREENCHER DADOS DA LOJA
        ======================================================
        */

        function carregarFornecedor(dados) {

            document.title =
                `${dados.nome} | PetSpace`;


            document
                .getElementById("nome-fornecedor")
                .textContent = dados.nome;


            document
                .getElementById("categoria-fornecedor")
                .innerHTML = `
                    <i class="fa-solid fa-paw"></i>
                    ${dados.categoria}
                `;


            document
                .getElementById("descricao-fornecedor")
                .textContent = dados.descricao;


            document
                .getElementById("telefone-fornecedor")
                .textContent = dados.telefone;


            document
                .getElementById("email-fornecedor")
                .textContent = dados.email;


            document
                .getElementById("endereco-fornecedor")
                .textContent = dados.endereco;


            document
                .getElementById("quantidade-produtos")
                .textContent =
                `${dados.totalProdutos} produtos`;


            document
                .getElementById("avaliacao-resumo")
                .textContent =
                `${dados.avaliacao} de 5.0`;


            document
                .getElementById("tempo-petspace")
                .textContent =
                `Desde ${dados.desde}`;


            document
                .getElementById("localizacao-resumo")
                .textContent =
                dados.endereco;


            document
                .getElementById("nota-fornecedor")
                .textContent =
                dados.avaliacao;


            document
                .getElementById("nota-geral-avaliacoes")
                .textContent =
                dados.avaliacao;


            document
                .getElementById("total-avaliacoes")
                .textContent =
                `${dados.totalAvaliacoes} avaliações`;


            document
                .getElementById("horario-fornecedor")
                .textContent =
                dados.horario;


            document
                .getElementById("entrega-fornecedor")
                .textContent =
                dados.entrega;


            document
                .getElementById("pagamento-fornecedor")
                .textContent =
                dados.pagamento;


            document
                .getElementById("logo-fornecedor")
                .src =
                dados.logo;


            document
                .getElementById("logo-fornecedor")
                .alt =
                `Logo da ${dados.nome}`;


            /*
            ==================================================
            CAPA
            ==================================================
            */

            const capa =
                document.getElementById(
                    "capa-fornecedor"
                );

            capa.style.backgroundImage =
                `url("${dados.capa}")`;


            /*
            ==================================================
            WHATSAPP
            ==================================================
            */

            const whatsapp =
                document.getElementById(
                    "whatsapp-fornecedor"
                );


            whatsapp.href =
                `https://wa.me/${dados.whatsapp}`;


            /*
            ==================================================
            STATUS
            ==================================================
            */

            const status =
                document.getElementById(
                    "status-fornecedor"
                );


            if (dados.status === "aberta") {

                status.innerHTML = `
                    <span class="status-ponto-fornecedor"></span>
                    Loja aberta
                `;

            } else {

                status.innerHTML = `
                    <span
                        class="status-ponto-fornecedor
                               status-fechado-fornecedor"
                    ></span>
                    Loja fechada
                `;

            }

        }


        /*
        ======================================================
        CARREGAR LOJA
        ======================================================
        */

        carregarFornecedor(fornecedor);


        /*
        ======================================================
        FUTURA API
        ======================================================

        Quando o backend estiver pronto, essa parte poderá
        substituir os dados temporários acima:

        fetch(`/api/fornecedores/${fornecedorId}`)
            .then(response => {

                if (!response.ok) {
                    throw new Error(
                        "Fornecedor não encontrado."
                    );
                }

                return response.json();

            })
            .then(dados => {

                carregarFornecedor(dados);

            })
            .catch(erro => {

                console.error(erro);

            });
        */


    </script>


