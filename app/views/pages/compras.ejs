<!DOCTYPE html>
<html lang="pt-BR">

<!-- =====================================================================
     PETSPACE - product.ejs
     ---------------------------------------------------------------------
     ÍNDICE
     1. Head (títulos, fontes e CSS)
     2. Cabeçalho (partials)
     3. Menu mobile inferior
     4. Banner
     5. Produtos
     6. Rodapé
     7. Scripts
====================================================================== -->


<!-- =====================================================================
     1. HEAD
====================================================================== -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PetSpace Compras</title>

    <!-- Ícones (Font Awesome) -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    >

    <!-- Fonte (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap"
        rel="stylesheet"
    >

    <!-- CSS da página -->
    <link rel="stylesheet" href="/css/product.css">
</head>


<body>

    <!-- =================================================================
         2. CABEÇALHO
         O logo, a busca e os botões de cima ficam dentro dos partials.
    ================================================================== -->
    <% if (!usuario) { %>
        <%- include("../partials/header-index") %>
    <% } else if (usuario.premium) { %>
        <%- include("../partials/header-premium") %>
    <% } else { %>
        <%- include("../partials/header-logado") %>
    <% } %>


    <!-- =================================================================
         3. MENU MOBILE INFERIOR
         Só aparece em telas até 768px (controlado pelo CSS).
    ================================================================== -->
   
    <nav class="navbar" aria-label="Menu mobile">

        <!-- 3.1 Menu que sobe -->
        <section id="bottom-mobile-menu" class="mobile-menu" aria-hidden="true">

            <!-- Botões de cima -->
            <section class="mobile-buttons">

                <% if (!usuario) { %>
                    <a href="/login">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                        Entrar
                    </a>

                    <a href="/cadastro">
                        <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                        Cadastre-se
                    </a>
                <% } else { %>
                    <!-- Ajuste a rota de sair para a que você usa no servidor -->
                    <a href="/logout">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                        Sair
                    </a>
                <% } %>

                <% if (!usuario || !usuario.premium) { %>
                    <a href="/petguardioes" class="btn-pro">
                        <i class="fa-solid fa-crown" aria-hidden="true"></i>
                        PetGuardião PRO
                    </a>
                <% } %>

            </section>

            <hr>

            <!-- Links -->
            <ul>
                <li>
                    <a href="#produtos">
                        <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
                        Produtos
                    </a>
                </li>

                <li>
                    <a href="/compras">
                        <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                        Compras
                    </a>
                </li>
<li>
                    <a href="/">
                        <i class="fa-solid fa-home" aria-hidden="true"></i>
                        Inicio
                    </a>
                </li>


                <li>
                    <a href="/contato">
                        <i class="fa-solid fa-phone" aria-hidden="true"></i>
                        Contato
                    </a>
                </li>
            </ul>

        </section>

        <!-- 3.2 Botão sanduíche -->
        <button
            id="bottom-menu-btn"
            class="menu-btn"
            type="button"
            aria-label="Abrir menu"
            aria-expanded="false"
            aria-controls="bottom-mobile-menu">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

    </nav>


    <!-- =================================================================
         4. BANNER PRINCIPAL
    ================================================================== -->
    <section class="hero">
        <article class="hero-text">
            <h1></h1>
            <p></p>
        </article>
    </section>


    <!-- =================================================================
         5. PRODUTOS
    ================================================================== -->
    <main class="main">
        <section class="container" id="produtos">
            <article
                class="products-grid"
                id="productsGrid"
                aria-label="Lista de produtos">
                <!-- Produtos inseridos pelo JavaScript (scripts.js) -->
            </article>
        </section>
    </main>


    <!-- =================================================================
         6. RODAPÉ
    ================================================================== -->
    <footer>
        <section class="tudo-footer">
            <section class="footer-content">

                <!-- 6.1 Sobre -->
                <section class="footer-column">
                    <h3>Sobre</h3>

                    <p class="footer-description">
                        O PetSpace é dedicado a um mundo mais sustentável
                        e fácil para você e seus amiguinhos. Um espaço
                        pensado para o bem-estar dos pets.
                    </p>

                    <section class="social-links">
                        <a href="#" aria-label="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                        <a href="#" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                        <a href="#" aria-label="Twitter">
                            <i class="fa-brands fa-twitter"></i>
                        </a>
                        <a href="#" aria-label="Pinterest">
                            <i class="fa-brands fa-pinterest"></i>
                        </a>
                    </section>
                </section>

                <!-- 6.2 Links úteis -->
                <section class="footer-column">
                    <h3>Links úteis</h3>

                    <ul class="footer-links">
                        <li><a href="#">Faça parte do nosso blog</a></li>
                        <li><a href="/fornecedor">Adicione seu perfil de vendas</a></li>
                        <li><a href="#">Curiosidades sobre pets</a></li>
                    </ul>
                </section>

                <!-- 6.3 Contato -->
                <section class="footer-column">
                    <h3>Entre em contato conosco</h3>

                    <ul class="footer-links">
                        <li>
                            <i class="fa-solid fa-phone"></i>
                            +55 (99) 99999-9999
                        </li>
                        <li>
                            <i class="fa-solid fa-envelope"></i>
                            PetSpace@gmail.com
                        </li>
                        <li>
                            <i class="fa-solid fa-clock"></i>
                            9h às 18h
                        </li>
                        <li>
                            <i class="fa-solid fa-map"></i>
                            Atendimento online
                        </li>
                    </ul>
                </section>

            </section>
        </section>
    </footer>


    <!-- =================================================================
         7. SCRIPTS
    ================================================================== -->

    <!-- 7.1 Controle do menu mobile -->
    <script>
        (() => {
            const menuBtn = document.getElementById("bottom-menu-btn");
            const mobileMenu = document.getElementById("bottom-mobile-menu");

            // Se algum dos dois não existir, não faz nada (evita erro)
            if (!menuBtn || !mobileMenu) return;

            const icon = menuBtn.querySelector("i");

            function abrir() {
                mobileMenu.classList.add("active");
                menuBtn.setAttribute("aria-expanded", "true");
                menuBtn.setAttribute("aria-label", "Fechar menu");
                mobileMenu.setAttribute("aria-hidden", "false");
                icon.classList.replace("fa-bars", "fa-xmark");
            }

            function fechar() {
                mobileMenu.classList.remove("active");
                menuBtn.setAttribute("aria-expanded", "false");
                menuBtn.setAttribute("aria-label", "Abrir menu");
                mobileMenu.setAttribute("aria-hidden", "true");
                icon.classList.replace("fa-xmark", "fa-bars");
            }

            // Clique no botão: abre ou fecha
            menuBtn.addEventListener("click", () => {
                if (mobileMenu.classList.contains("active")) {
                    fechar();
                } else {
                    abrir();
                }
            });

            // Clique em um link do menu: fecha
            mobileMenu.querySelectorAll("a").forEach(link => {
                link.addEventListener("click", fechar);
            });

            // Clique fora do menu: fecha
            document.addEventListener("click", (e) => {
                if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
                    fechar();
                }
            });

            // Tecla Esc: fecha
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") fechar();
            });
        })();
    </script>

    <!-- 7.2 Produtos (incluir somente uma vez) -->
    <script src="/scripts/scripts.js"></script>

</body>
</html>
