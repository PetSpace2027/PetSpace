<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="css/product.css">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap"
        rel="stylesheet">


    <title>PetSpace Compras</title>
</head>
<body>

<% if (!usuario) { %>

    <%- include("../partials/header-index") %>

<% } else if (usuario.premium) { %>

    <%- include("../partials/header-premium") %>

<% } else { %>

    <%- include("../partials/header-logado") %>

<% } %>


 <nav
        class="navbar"
        aria-label="Menu mobile">
 
        <!-- MENU QUE SOBE -->
        <section
            id="mobile-menu"
            class="mobile-menu"
            aria-hidden="true">
 
 
            <!-- BOTÕES -->
            <section class="mobile-buttons">
 
                <a
                    href="/login"
                    class="btn btn-secondary">
 
                    <i
                        class="fa-solid fa-user"
                        aria-hidden="true">
                    </i>
 
                    Entrar
 
                </a>
 
 
                <a
                    href="/cadastro"
                    class="btn btn-primary">
 
                    <i
                        class="fa-solid fa-user-plus"
                        aria-hidden="true">
                    </i>
 
                    Cadastre-se
 
                </a>
 
 
              <a href="/petguardioes" class="btn-pro"><i class="fa-solid fa-crown"></i> PetGuardião PRO</a>

 
            </section>
 
 
            <hr>
 
 
            <!-- LINKS -->
            <ul>
 
                <li>
 
                    <a href="#product">
 
                        <i
                            class="fa-solid fa-bag-shopping"
                            aria-hidden="true">
                        </i>
 
                        Produtos
 
                    </a>
 
                </li>
 
 
                <li>
 
                    <a href="/compras">
 
                        <i
                            class="fa-solid fa-cart-shopping"
                            aria-hidden="true">
                        </i>
 
                        Compras
 
                    </a>
 
                </li>
 
 
                <li>
 
                    <a href="/contato">
 
                        <i
                            class="fa-solid fa-phone"
                            aria-hidden="true">
                        </i>
 
                        Contato
 
                    </a>
 
                </li>
 
            </ul>
 
        </section>
 
 
        <!-- BOTÃO SANDUÍCHE -->
        <button
            id="menu-btn"
            class="menu-btn"
            type="button"
            aria-label="Abrir menu"
            aria-expanded="false"
            aria-controls="mobile-menu">
 
            <i
                class="fa-solid fa-bars"
                aria-hidden="true">
            </i>
 
        </button>
 
    </nav>


 
    <section class="hero">
        
        <article class="hero-text">

            <h1> </h1>
            <p></p>

        </article>




    </section>

    <main class="main">
        <section class="container" id="produtos">
            <article class="products-grid" id="productsGrid">
                <!--produtos por java-->

            </article>

        </section>
    </main>



    <footer>
            <section class="tudo-footer">
                <section class="footer-content">
                    <section class="footer-column">
                        <h3>Sobre </h3>
                        <p style="color:var( --paw-cream);margin-bottom: 20px;">PetSpace dedicado a um mundo mais
                            sustentavel, e facil para voce e seus amiguinhos PetSpace
                            um perfeito desenvolvimento ambiental.
                        </p>
                        <section class="social-links">
                            <a href="#"><i class="fa-brands fa-facebook-f" style="color: rgb(0, 0, 0);"></i></a>
                            <a href="#"><i class="fa-brands fa-instagram" style="color: rgb(0, 0, 0);"></i></a>
                            <a href="#"><i class="fa-brands fa-twitter" style="color: rgb(0, 0, 0);"></i></a>
                            <a href=""><i class="fa-brands fa-pinterest" style="color: rgb(0, 0, 0);"></i></a>

                        </section>
                    </section>

                    <section class="footer-column">
                        <h3>Clique Links</h3>
                        <ul class="footer-links">
                            <li><a href="#">Faça parte do nosso blog</a></li>
                            <li><a href="#">Adione seu perfil de vendas</a></li>
                            <li><a href="#">Curiosidades


                        </ul>
                    </section>
                    <section class="footer-column">
                        <h3>Entre em Contato conosco</h3>
                        <ul class="footer-links">
                            <li><i class="fa-solid fa-phone" style="color: rgb(255, 193, 59);"></i>+55 (99) 99999-9999
                            </li>
                            <li><i class="fa-solid fa-envelope" style="color: rgb(255, 193, 59);"></i>PetSpace@gmail.com
                            </li>
                            <li><i class="fa-solid fa-clock" style="color: rgb(255, 193, 59);"></i>9:00 as 18:00</li>
                            <li><i class="fa-regular fa-map" style="color: rgb(255, 193, 59);"></i>9:00 as 18:00</li>




                        </ul>

                    </section>
                </section>
            </section>

           
        </footer>
<script>
    
const menuBtn = document.querySelector(".menu-btn");
const nav = document.querySelector("nav");

menuBtn.addEventListener("click", () => {
    nav.classList.toggle("active");
});e("active");

</script>
    <script src="scripts/scripts.js"></script>


</body>

</html>