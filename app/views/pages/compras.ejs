    <!-- CONTROLE DO MENU MOBILE -->
   
<!-- CONTROLE DO MENU MOBILE -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (!menuBtn || !mobileMenu) return;

    const icon = menuBtn.querySelector("i");

    function fecharMenu() {
        mobileMenu.classList.remove("active");
        menuBtn.setAttribute("aria-expanded", "false");
        menuBtn.setAttribute("aria-label", "Abrir menu");
        mobileMenu.setAttribute("aria-hidden", "true");

        if (icon) {
            icon.classList.remove("fa-xmark");
            icon.classList.add("fa-bars");
        }
    }

    function alternarMenu(event) {
        event.stopPropagation();

        const aberto = !mobileMenu.classList.contains("active");

        mobileMenu.classList.toggle("active", aberto);
        menuBtn.setAttribute("aria-expanded", String(aberto));
        menuBtn.setAttribute(
            "aria-label",
            aberto ? "Fechar menu" : "Abrir menu"
        );
        mobileMenu.setAttribute("aria-hidden", String(!aberto));

        if (icon) {
            icon.classList.toggle("fa-bars", !aberto);
            icon.classList.toggle("fa-xmark", aberto);
        }
    }

    menuBtn.addEventListener("click", alternarMenu);

    mobileMenu.addEventListener("click", event => {
        event.stopPropagation();
    });

    mobileMenu.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", fecharMenu);
    });

    document.addEventListener("click", event => {
        if (
            !mobileMenu.contains(event.target) &&
            !menuBtn.contains(event.target)
        ) {
            fecharMenu();
        }
    });

    document.addEventListener("keydown", event => {
        if (event.key === "Escape") {
            fecharMenu();
        }
    });

    window.addEventListener("resize", () => {
        if (window.innerWidth > 768) {
            fecharMenu();
        }
    });

    fecharMenu();
});
</script>

<!-- SCRIPT DOS PRODUTOS -->
<script src="/scripts/scripts.js"></script>


    <!-- SCRIPT DOS PRODUTOS -->
    <script src="/scripts/scripts.js"></script>

</body>
